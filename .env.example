# Postgres (pgvector)
DATABASE_URL=postgres://postmortem:postmortem@localhost:5432/postmortem

# SQS
AWS_REGION=us-east-1
SQS_QUEUE_URL=http://localhost:9324/000000000000/postmortem-ingest
# Local only (ElasticMQ). Leave empty in production to use the default AWS SQS endpoint.
SQS_ENDPOINT=http://localhost:9324
# ElasticMQ accepts any credentials. In production, use an IAM role / real credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
